{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "description": "Structured recipe extracted from video",
  "type": "object",
  "properties": {
    "title": {
      "type": ["string", "null"],
      "description": "Recipe title (if available from video)"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "description": "Original YouTube or Instagram video URL"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Ingredient"
      },
      "description": "List of ingredients with quantities"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Step"
      },
      "description": "Sequential cooking steps with timestamps"
    },
    "extraction_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of extraction"
    },
    "processing_time": {
      "type": "number",
      "description": "Total processing time in seconds"
    },
    "metadata": {
      "type": "object",
      "description": "Additional processing metadata",
      "properties": {
        "models_used": {
          "type": "object",
          "properties": {
            "object_detection": { "type": "string" },
            "ocr": { "type": "string" },
            "transcription": { "type": "string" },
            "nlp": { "type": "string" }
          }
        },
        "config": {
          "type": "object"
        }
      }
    }
  },
  "required": ["source_url", "ingredients", "steps"],
  "definitions": {
    "Ingredient": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Ingredient name"
        },
        "quantity": {
          "type": ["number", "null"],
          "description": "Numeric quantity"
        },
        "unit": {
          "type": ["string", "null"],
          "description": "Unit of measurement (cup, tsp, g, ml, etc.)"
        },
        "source": {
          "type": "string",
          "enum": ["visual", "ocr", "audio", "merged"],
          "description": "Detection source"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score 0-1"
        },
        "timestamp": {
          "type": ["number", "null"],
          "description": "Video timestamp in seconds"
        },
        "raw_text": {
          "type": ["string", "null"],
          "description": "Original text before parsing"
        }
      },
      "required": ["name", "source", "confidence"]
    },
    "Step": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "description": "Step number"
        },
        "description": {
          "type": "string",
          "description": "Step description"
        },
        "timestamp": {
          "type": "number",
          "description": "Video timestamp in seconds"
        },
        "action": {
          "type": ["string", "null"],
          "enum": ["mix", "whisk", "bake", "boil", "chop", "slice", "heat", "add", "pour", "stir", "cool", "refrigerate", null],
          "description": "Primary cooking action verb"
        },
        "source": {
          "type": "string",
          "enum": ["audio", "ocr", "inferred"],
          "description": "How step was detected"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Extraction confidence"
        }
      },
      "required": ["sequence", "description", "timestamp"]
    }
  }
}
